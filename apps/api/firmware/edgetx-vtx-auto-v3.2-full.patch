+void menuModelVtxSort(event_t event)
+{
+  uint8_t sub = menuVerticalPosition - HEADER_LINE;
+
+  if (event == EVT_KEY_BREAK(KEY_ENTER)) {
+    VtxProfile* pr = currentVtxProfile();
+    if (pr) {
+      if (sub == 0) sortPairsByBandChan(pr);
+      else if (sub == 1) sortPairsByValue(pr);
+    }
+    popMenu();
+    killEvents(event);
+    return;
+  }
+
+  SIMPLE_SUBMENU("SORT", HEADER_LINE + 2);
+  sub = menuVerticalPosition - HEADER_LINE;
+
+  static const char* const sortNames[] = { "Band/chan", "Value" };
+  for (uint8_t i = 0; i < LCD_LINES - 1; i++) {
+    coord_t y = MENU_HEADER_HEIGHT + 1 + i * FH;
+    uint8_t k = i + menuVerticalOffset;
+    if (k >= 2) continue;
+    LcdFlags attr = (sub == k ? INVERS : 0);
+    lcdDrawText(2 * FW, y, sortNames[k], attr);
