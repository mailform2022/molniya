+void menuModelVtxAuto(event_t event)
+{
+  uint8_t old_editMode = s_editMode;
+  VtxProfile* pr = currentVtxProfile();
+  if (!pr) return;
+
+  if (s_editMode == 0) vtxProfileNameEdit = false;
+
+  uint8_t mstate_tab[ITEM_VTX_COUNT];
+  updateVtxMStateTab(mstate_tab, pr);
