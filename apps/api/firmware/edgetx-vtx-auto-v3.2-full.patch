diff --git a/radio/src/gui/128x64/model_vtx_auto.cpp b/radio/src/gui/128x64/model_vtx_auto.cpp
new file mode 100644
index 0000000000..d1ef71a57b
--- /dev/null
+++ b/radio/src/gui/128x64/model_vtx_auto.cpp
@@ -0,0 +1,794 @@
+/*
+ * Copyright (C) EdgeTX
+ *
+ * This file is part of EdgeTX.
+ */
+
+#include "edgetx.h"
+#include "vtx_auto.h"
+
+#if defined(RADIO_TX12) || defined(RADIO_TX12MK2) || defined(RADIO_POCKET) || defined(RADIO_BOXER)
+
+#define VTX_2ND_COLUMN (8 * FW)
+
+enum {
+  ITEM_VTX_ENABLED,
+  ITEM_VTX_PROFILE,
+  ITEM_VTX_ADD_PROFILE,
+  ITEM_VTX_DELETE_PROFILE,
+  ITEM_VTX_CHANNEL,
+  ITEM_VTX_MODE,
+  ITEM_VTX_MANUAL_TYPE,
+  ITEM_VTX_TIME_TYPE,
+  ITEM_VTX_FIXED_TIME,
+  ITEM_VTX_MIN_TIME,
+  ITEM_VTX_MAX_TIME,
+  ITEM_VTX_BAND_SRC,
+  ITEM_VTX_CHAN_SRC,
+  ITEM_VTX_MODE_SRC,
+  ITEM_VTX_PAIRS,
+  ITEM_VTX_FAVORITES,
+  ITEM_VTX_COUNT
+};
+
+static bool vtxProfileNameEdit = false;
+
+static const char* const vtxOnOffNames[] = { "Off", "On" };
+static const char* const vtxModeNames[] = { "Manual", "Auto" };
+static const char* const vtxManualTypeNames[] = { "Band+Chan", "Pair step" };
+static const char* const vtxTimeNames[] = { "Fixed", "Rand" };
+
+// Times are stored in 0.1 s units for storage compatibility, but edited and shown in whole seconds.
+#define VTX_TIME_MAX_S 1800
+static inline int16_t vtxTimeSeconds(uint16_t stored)
+{
+  int16_t s = (int16_t)((stored + 5) / 10);
+  return s < 1 ? 1 : s;
+}
+static const char* const vtxVisibleNames[] = { "All", "Fav" };
+
+static VtxProfile* currentVtxProfile()
+{
+  uint8_t idx = g_model.vtxAuto.activeProfile;
+  if (g_model.vtxAuto.profileCount == 0) {
+    g_model.vtxAuto.profileCount = 1;
+    idx = 0;
+  }
+  if (idx >= g_model.vtxAuto.profileCount) idx = g_model.vtxAuto.profileCount - 1;
+  return &g_model.vtxAuto.profiles[idx];
+}
+
+static int8_t findFavoritePairIndex(const VtxProfile* pr, const VtxFavorite& fav)
+{
+  for (uint8_t i = 0; i < pr->pairCount; i++) {
+    if (pr->pairs[i].band == fav.band && pr->pairs[i].channel == fav.channel)
+      return (int8_t)i;
+  }
+  return -1;
+}
+
+static void drawPairAt(coord_t x, coord_t y, uint8_t idx, LcdFlags attr)
+{
+  uint8_t b = vtxGetBandLetter(idx);
+  uint8_t code = vtxGetChannelCode(idx);
+  uint8_t disp = vtxGetChannelDisplayChar(idx);
+  lcdDrawChar(x, y, b, attr);
+  if (disp) {
+    lcdDrawChar(x + FW, y, disp, attr);
+  } else if (code >= 10) {
+    lcdDrawNumber(x + FW, y, code, attr | LEFT);
+  } else {
+    lcdDrawChar(x + FW, y, '0' + code, attr);
+  }
+}
+
+static void drawFavoritePair(coord_t x, coord_t y, const VtxFavorite& fav, LcdFlags attr)
+{
+  if (fav.src <= MIXSRC_NONE || fav.src > MIXSRC_LAST) {
+    lcdDrawText(x, y, "--", attr);
+    return;
+  }
+  VtxProfile* pr = currentVtxProfile();
+  int8_t idx = findFavoritePairIndex(pr, fav);
+  if (idx < 0) {
+    lcdDrawText(x, y, "--", attr);
+    return;
+  }
+  drawPairAt(x, y, (uint8_t)idx, attr);
+}
+
+void menuModelVtxPair(event_t event);
+void menuModelVtxPairs(event_t event);
+void menuModelVtxFavorite(event_t event);
+void menuModelVtxFavorites(event_t event);
+void menuModelVtxSort(event_t event);
+
+static bool isVtxPairStepMode(const VtxProfile* pr)
+{
+  return (pr->timeType >> 1) & 1;
+}
+
+static bool isVtxBandAvailable(int value)
+{
+  VtxProfile* pr = currentVtxProfile();
+  if (!pr || s_currIdxSubMenu >= pr->pairCount) return true;
+  for (uint8_t i = 0; i < pr->pairCount; i++) {
+    if (i == s_currIdxSubMenu) continue;
+    if (pr->pairs[i].band == (uint8_t)value &&
+        pr->pairs[i].channel == pr->pairs[s_currIdxSubMenu].channel)
+      return false;
+  }
+  return true;
+}
+
+static bool isVtxChannelAvailable(int value)
+{
+  VtxProfile* pr = currentVtxProfile();
+  if (!pr || s_currIdxSubMenu >= pr->pairCount) return true;
+  for (uint8_t i = 0; i < pr->pairCount; i++) {
+    if (i == s_currIdxSubMenu) continue;
+    if (pr->pairs[i].band == pr->pairs[s_currIdxSubMenu].band &&
+        pr->pairs[i].channel == (uint8_t)value)
+      return false;
+  }
+  return true;
+}
+
+void menuModelVtxPair(event_t event)
+{
+  VtxProfile* pr = currentVtxProfile();
+  if (!pr || s_currIdxSubMenu >= pr->pairCount) {
+    popMenu();
+    return;
+  }
+
+  uint8_t sub = menuVerticalPosition - HEADER_LINE;
+
+  if (event == EVT_KEY_BREAK(KEY_ENTER) && sub == 5) {
+    for (uint8_t i = s_currIdxSubMenu; i < pr->pairCount - 1; i++) {
+      pr->pairs[i] = pr->pairs[i + 1];
+    }
+    pr->pairCount--;
+    killEvents(event);
+    popMenu();
+    return;
+  }
+
+  SIMPLE_SUBMENU("EDIT PAIR", HEADER_LINE + 6);
+
+  VtxPair& p = pr->pairs[s_currIdxSubMenu];
+
+  for (uint8_t i = 0; i < LCD_LINES - 1; i++) {
+    coord_t y = MENU_HEADER_HEIGHT + 1 + i * FH;
+    uint8_t k = i + menuVerticalOffset;
+    LcdFlags attr = (sub == k ? (s_editMode > 0 ? BLINK | INVERS : INVERS) : 0);
+    bool active = (attr && s_editMode > 0);
+
+    if (k >= 6) continue;
+
+    switch (k) {
+      case 0:
+        lcdDrawTextAlignedLeft(y, "Band");
+        lcdDrawChar(VTX_2ND_COLUMN, y, 'A' + p.band, attr);
+        if (active) {
+          CHECK_INCDEC_MODELVAR_CHECK(event, p.band, 0, 25, isVtxBandAvailable);
+        }
+        break;
+
+      case 1:
+        lcdDrawTextAlignedLeft(y, "Channel");
+        {
+          uint8_t code = p.channel;
+          uint8_t disp = 0;
+          if (code >= 100 && code < 100 + 20) {
+            // Map special channel codes 100..119 to labels 0..9, A-G, U, P, H
+            static const char special[] = "0123456789ABCDEFGUPH";
+            disp = special[code - 100];
+          }
+          if (disp) {
+            lcdDrawChar(VTX_2ND_COLUMN, y, disp, attr);
+          } else if (code >= 10) {
+            lcdDrawNumber(VTX_2ND_COLUMN, y, code, attr | LEFT);
+          } else {
+            lcdDrawChar(VTX_2ND_COLUMN, y, '0' + code, attr);
+          }
+        }
+        if (active) {
+          CHECK_INCDEC_MODELVAR_CHECK(event, p.channel, 1, 119, isVtxChannelAvailable);
+        }
+        break;
+
+      case 2:
+        lcdDrawTextAlignedLeft(y, "Value");
+        {
+          int16_t v = vtxGetPairValue(p.value);
+          lcdDrawNumber(VTX_2ND_COLUMN, y, v, attr | LEFT);
+          if (active) {
+            CHECK_INCDEC_MODELVAR(event, v, -100, 100);
+            p.value = vtxEncodePairValue(v, vtxGetPairPriority(p.value), vtxGetPairVisible(p.value));
+          }
+        }
+        break;
+
+      case 3:
+        lcdDrawTextAlignedLeft(y, "Priority");
+        {
+          uint8_t priority = vtxGetPairPriority(p.value);
+          if (priority == 0) {
+            lcdDrawText(VTX_2ND_COLUMN, y, "---", attr);
+          } else {
+            lcdDrawNumber(VTX_2ND_COLUMN, y, priority, attr | LEFT);
+          }
+          if (active) {
+            uint8_t ptmp = priority;
+            CHECK_INCDEC_MODELVAR(event, ptmp, 0, 10);
