+    menuVerticalPosition = HEADER_LINE + ITEM_VTX_COUNT - 1;
+  }
+#if HEADER_LINE > 0
+  if (menuVerticalPosition < HEADER_LINE) {
+    menuVerticalPosition = HEADER_LINE;
+  }
+#endif
+
+  uint8_t sub = menuVerticalPosition - HEADER_LINE;
+  if (sub >= ITEM_VTX_COUNT) sub = ITEM_VTX_COUNT - 1;
+
+  if (event == EVT_KEY_BREAK(KEY_ENTER) && sub < ITEM_VTX_COUNT && mstate_tab[sub] != HIDDEN_ROW) {
+    switch (sub) {
+      case ITEM_VTX_PAIRS:
+        pushMenu(menuModelVtxPairs);
+        killEvents(event);
+        return;
+
+      case ITEM_VTX_FAVORITES:
+        pushMenu(menuModelVtxFavorites);
+        killEvents(event);
+        return;
+
+      case ITEM_VTX_ADD_PROFILE:
+        if (g_model.vtxAuto.profileCount < MAX_VTX_PROFILES) {
+          uint8_t idx = g_model.vtxAuto.profileCount++;
+          VtxProfile& np = g_model.vtxAuto.profiles[idx];
+          VtxProfile& ap = g_model.vtxAuto.profiles[g_model.vtxAuto.activeProfile];
+          np = ap;
+          memset(np.name, 0, sizeof(np.name));
+          const char* base = "New";
+          uint8_t j = 0;
+          while (j < 3 && j < sizeof(np.name) - 1) {
+            np.name[j] = base[j];
+            j++;
+          }
+          g_model.vtxAuto.activeProfile = idx;
+          storageDirty(EE_MODEL);
+        }
+        killEvents(event);
+        return;
+
+      case ITEM_VTX_DELETE_PROFILE:
+        if (g_model.vtxAuto.profileCount > 1) {
+          uint8_t idx = g_model.vtxAuto.activeProfile;
+          for (uint8_t i = idx; i < g_model.vtxAuto.profileCount - 1; i++) {
+            g_model.vtxAuto.profiles[i] = g_model.vtxAuto.profiles[i + 1];
+          }
+          g_model.vtxAuto.profileCount--;
+          if (g_model.vtxAuto.activeProfile >= g_model.vtxAuto.profileCount)
+            g_model.vtxAuto.activeProfile = g_model.vtxAuto.profileCount - 1;
+          pr = currentVtxProfile();
+          storageDirty(EE_MODEL);
+        }
+        killEvents(event);
+        return;
+
+      case ITEM_VTX_PROFILE:
+        if (s_editMode == 0) {
+          s_editMode = EDIT_MODIFY_FIELD;
+          vtxProfileNameEdit = false;
+          killEvents(event);
+          event = 0;
+        } else if (!vtxProfileNameEdit && s_editMode == EDIT_MODIFY_FIELD) {
+          vtxProfileNameEdit = true;
+          s_editMode = EDIT_MODIFY_STRING;
+          editNameCursorPos = 0;
+          killEvents(event);
+          event = 0;
+        }
+        break;
+
+      default:
+        break;
+    }
+  }
+
+  MENU_CHECK(menuTabModel, MENU_MODEL_VTX_AUTO, HEADER_LINE + ITEM_VTX_COUNT);
+  title("VTX AUTO");
+
+  sub = menuVerticalPosition - HEADER_LINE;
