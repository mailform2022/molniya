+
+  for (uint8_t k = 0; k < LCD_LINES - 1; k++) {
+    int i = k + menuVerticalOffset;
+    for (int j = 0; j <= i; ++j) {
+      if (j < (int)DIM(mstate_tab) && mstate_tab[j] == HIDDEN_ROW) {
