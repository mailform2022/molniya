+static void sortPairsByBandChan(VtxProfile* pr)
+{
+  if (!pr || pr->pairCount < 2) return;
+  for (uint8_t i = 0; i < pr->pairCount - 1; i++) {
+    for (uint8_t j = i + 1; j < pr->pairCount; j++) {
+      bool swap = false;
+      if (pr->pairs[i].band > pr->pairs[j].band) {
+        swap = true;
+      } else if (pr->pairs[i].band == pr->pairs[j].band &&
+                 pr->pairs[i].channel > pr->pairs[j].channel) {
+        swap = true;
+      }
+      if (swap) {
+        VtxPair t = pr->pairs[i];
+        pr->pairs[i] = pr->pairs[j];
+        pr->pairs[j] = t;
+      }
+    }
+  }
+}
+
+static void sortPairsByValue(VtxProfile* pr)
+{
+  if (!pr || pr->pairCount < 2) return;
+  for (uint8_t i = 0; i < pr->pairCount - 1; i++) {
+    for (uint8_t j = i + 1; j < pr->pairCount; j++) {
+      if (vtxGetPairValue(pr->pairs[i].value) > vtxGetPairValue(pr->pairs[j].value)) {
+        VtxPair t = pr->pairs[i];
+        pr->pairs[i] = pr->pairs[j];
+        pr->pairs[j] = t;
+      }
+    }
+  }
+}
