+void menuModelVtxFavorite(event_t event)
+{
+  VtxProfile* pr = currentVtxProfile();
+  if (!pr || s_currIdxSubMenu >= MAX_VTX_FAVORITES) {
+    popMenu();
+    return;
+  }
+
+  uint8_t sub = menuVerticalPosition - HEADER_LINE;
+  VtxFavorite& f = pr->favorites[s_currIdxSubMenu];
+
+  SIMPLE_SUBMENU("EDIT FAV", HEADER_LINE + 2);
+
+  for (uint8_t i = 0; i < LCD_LINES - 1; i++) {
+    coord_t y = MENU_HEADER_HEIGHT + 1 + i * FH;
+    uint8_t k = i + menuVerticalOffset;
+    LcdFlags attr = (sub == k ? (s_editMode > 0 ? BLINK | INVERS : INVERS) : 0);
+    bool active = (attr && s_editMode > 0);
+
+    if (k >= 2) continue;
+
+    switch (k) {
+      case 0:
+        lcdDrawTextAlignedLeft(y, "Source");
+        if (f.src <= MIXSRC_NONE) {
+          lcdDrawText(VTX_2ND_COLUMN, y, "---", attr);
+        } else {
+          drawSource(VTX_2ND_COLUMN, y, f.src, attr);
+        }
+        if (active) {
+          CHECK_INCDEC_MODELSOURCE(event, f.src, MIXSRC_NONE, MIXSRC_LAST);
+        }
+        break;
+
+      case 1: {
+        lcdDrawTextAlignedLeft(y, "Pair");
+        if (pr->pairCount == 0) {
+          lcdDrawText(VTX_2ND_COLUMN, y, "--", attr);
+          break;
+        }
+        uint8_t pairIdx = 0;
+        int8_t found = findFavoritePairIndex(pr, f);
+        if (found >= 0) {
+          pairIdx = (uint8_t)found;
+        } else {
+          f.band = pr->pairs[0].band;
+          f.channel = pr->pairs[0].channel;
+        }
+        if (active) {
+          CHECK_INCDEC_MODELVAR_ZERO(event, pairIdx, pr->pairCount - 1);
+          f.band = pr->pairs[pairIdx].band;
+          f.channel = pr->pairs[pairIdx].channel;
+        }
+        drawPairAt(VTX_2ND_COLUMN, y, pairIdx, attr);
+        break;
+      }
+    }
+  }
+}
