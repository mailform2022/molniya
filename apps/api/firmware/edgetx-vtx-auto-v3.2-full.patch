+
+// Time is stored in 0.1 s units; ticks are 10 ms.
+// 0.5 s = 50 ticks, 1.0 s = 100 ticks, 1.5 s = 150, 2.5 s = 250, 3.0 s = 300.
+#define VTX_SHORT_MIN   1    // any short press up to 1.0 s
+#define VTX_SHORT_MAX   100  // 1.0 s
+#define VTX_MED_MIN     150  // 1.5 s
+#define VTX_MED_MAX     250  // 2.5 s
+#define VTX_RESET_HOLD  300  // 3.0 s
+
+#define VTX_ADV_CHANNEL 0
+#define VTX_ADV_BAND    1
+#define VTX_ADV_PAIR    2
+
+// Special channel labels (e.g. for FF3.7): 0-9, A-G, U, P, H.
+// Stored as channel code = 100 + index.
+static const char VTX_SPECIAL_CHANNELS[] = "0123456789ABCDEFGUPH";
+#define VTX_SPECIAL_CHANNEL_COUNT (sizeof(VTX_SPECIAL_CHANNELS) - 1)
+
+static uint8_t  vtxCurrentIndex = 0;
+static uint8_t  vtxCurrentBand = 0;
+static uint8_t  vtxCurrentChannel = 1;
+
+static tmr10ms_t vtxSwitchTimer[3] = { 0, 0, 0 };
+static bool      vtxSwitchActive[3] = { false, false, false };
+static bool      vtxSwitchReset[3] = { false, false, false };
+
+static tmr10ms_t vtxHoldTimer = 0;
+static uint32_t  vtxIntervalTicks = 0;
+static uint32_t  vtxRng = 0x12345678;
+
+static uint8_t   vtxPrevMode = 0xFF;
+static uint8_t   vtxPrevProfile = 0xFF;
+
+static bool      vtxFavoritePrev[MAX_VTX_FAVORITES] = { false };
+
+static VtxProfile& currentProfile()
+{
+  uint8_t idx = g_model.vtxAuto.activeProfile;
+  if (g_model.vtxAuto.profileCount == 0) {
+    g_model.vtxAuto.profileCount = 1;
+    idx = 0;
+  }
+  if (idx >= g_model.vtxAuto.profileCount) idx = g_model.vtxAuto.profileCount - 1;
+  return g_model.vtxAuto.profiles[idx];
+}
+
+static uint32_t vtxRand()
+{
+  if (vtxRng == 0x12345678) vtxRng += get_tmr10ms();
+  vtxRng = vtxRng * 1664525u + 1013904223u;
+  return vtxRng;
+}
+
+int16_t vtxEncodePairValue(int16_t value, uint8_t priority, uint8_t visible)
+{
+  uint16_t v9 = (uint16_t)(int16_t)value & 0x1FF;
+  uint16_t raw = 0x8000 | ((visible & 0x01) << 13) | ((priority & 0x0F) << 9) | v9;
+  return (int16_t)raw;
+}
+
+int16_t vtxGetPairValue(int16_t raw)
+{
+  if (((uint16_t)raw & 0xC000) != 0x8000) return raw;
+  uint16_t v = (uint16_t)raw & 0x1FF;
+  if (v & 0x100) v |= 0xFE00;
+  return (int16_t)v;
+}
+
+uint8_t vtxGetPairPriority(int16_t raw)
+{
+  if (((uint16_t)raw & 0xC000) != 0x8000) return 0;
+  return ((uint16_t)raw >> 9) & 0x0F;
+}
+
+uint8_t vtxGetPairVisible(int16_t raw)
+{
+  if (((uint16_t)raw & 0xC000) != 0x8000) return 0;
+  return ((uint16_t)raw >> 13) & 0x01;
+}
+
+uint8_t vtxGetCurrentIndex()
+{
+  return vtxCurrentIndex;
+}
+
+void vtxSetCurrentIndex(uint8_t idx)
+{
+  VtxProfile& pr = currentProfile();
+  uint8_t pairCount = pr.pairCount;
+  if (pairCount == 0) {
+    vtxCurrentIndex = 0;
+    return;
+  }
+  if (idx >= pairCount) idx = pairCount - 1;
+  vtxCurrentIndex = idx;
+  vtxCurrentBand = pr.pairs[idx].band;
+  vtxCurrentChannel = pr.pairs[idx].channel;
+}
+
+uint8_t vtxGetBandLetter(uint8_t idx)
+{
+  VtxProfile& pr = currentProfile();
+  if (idx >= pr.pairCount) return 0;
+  uint8_t b = pr.pairs[idx].band;
+  if (b < 26) return 'A' + b;
+  return 'A';
+}
+
+uint8_t vtxGetChannelCode(uint8_t idx)
+{
+  VtxProfile& pr = currentProfile();
+  if (idx >= pr.pairCount) return 1;
+  uint8_t c = pr.pairs[idx].channel;
+  if (c < 1) c = 1;
+  return c;
+}
+
+uint8_t vtxGetChannelDisplayChar(uint8_t idx)
+{
+  uint8_t code = vtxGetChannelCode(idx);
+  if (code >= 100 && code < 100 + VTX_SPECIAL_CHANNEL_COUNT)
+    return VTX_SPECIAL_CHANNELS[code - 100];
+  return 0;
+}
+
+const char* vtxGetCurrentBandChanStr()
+{
+  static char buf[8];
+  VtxProfile& pr = currentProfile();
+  if (pr.pairCount == 0) {
+    buf[0] = '-';
+    buf[1] = '\0';
+    return buf;
+  }
+  uint8_t idx = vtxCurrentIndex;
+  if (idx >= pr.pairCount) idx = pr.pairCount - 1;
+  uint8_t b = vtxGetBandLetter(idx);
+  uint8_t code = vtxGetChannelCode(idx);
+  uint8_t disp = vtxGetChannelDisplayChar(idx);
+  buf[0] = b;
+  if (disp) {
+    buf[1] = disp;
+    buf[2] = '\0';
+  } else if (code >= 10) {
+    buf[1] = '0' + code / 10;
+    buf[2] = '0' + code % 10;
+    buf[3] = '\0';
+  } else {
+    buf[1] = '0' + code;
+    buf[2] = '\0';
+  }
+  return buf;
+}
+
+bool isVtxAutoEnabled()
+{
+  return g_model.vtxAuto.enabled != 0;
+}
+
+static bool isTrimSource(int16_t src)
+{
+  return src >= MIXSRC_FIRST_TRIM && src <= MIXSRC_LAST_TRIM;
+}
+
+bool isVtxTrimSource(int16_t src)
+{
+  if (!isVtxAutoEnabled() || !isTrimSource(src)) return false;
+
+  VtxProfile& pr = currentProfile();
+  if (pr.bandSrc == src) return true;
+  if (pr.modeSrc == src) return true;
+
+  // In pair-step manual mode the Chan sw is not used.
+  if (((pr.timeType >> 1) & 1) == 0 && pr.chanSrc == src) return true;
+
+  for (uint8_t i = 0; i < MAX_VTX_FAVORITES; i++) {
+    if (pr.favorites[i].src == src) return true;
+  }
+
+  return false;
+}
+
+static bool isSourceActive(mixsrc_t src)
+{
+  if (src <= MIXSRC_NONE || src > MIXSRC_LAST) return false;
+  getvalue_t v = getValue(src);
+  return (abs(v) > 512);
+}
+
+static bool isTrimActive(mixsrc_t src, bool& left, bool& right)
+{
+  left = false;
+  right = false;
+  if (src < MIXSRC_FIRST_TRIM || src > MIXSRC_LAST_TRIM) return false;
+
+  uint8_t trimIdx = (uint8_t)(src - MIXSRC_FIRST_TRIM);
+  uint8_t phys = inputMappingConvertMode(trimIdx);
+  left = trimDown(phys * 2);
+  right = trimDown(phys * 2 + 1);
+  return left || right;
+}
+
+static uint8_t getUniqueBands(uint8_t* bands)
+{
+  uint8_t count = 0;
+  VtxProfile& pr = currentProfile();
+  uint8_t pairCount = pr.pairCount;
+  for (uint8_t i = 0; i < pairCount; i++) {
+    if (vtxGetPairVisible(pr.pairs[i].value) != 0) continue;
+    uint8_t b = pr.pairs[i].band;
+    bool found = false;
+    for (uint8_t j = 0; j < count; j++) {
+      if (bands[j] == b) { found = true; break; }
+    }
+    if (!found) bands[count++] = b;
+  }
+  for (uint8_t i = 0; i < count; i++) {
+    for (uint8_t j = i + 1; j < count; j++) {
+      if (bands[j] < bands[i]) {
+        uint8_t t = bands[i];
+        bands[i] = bands[j];
+        bands[j] = t;
+      }
+    }
+  }
+  return count;
+}
+
+static uint8_t getUniqueChannels(uint8_t band, uint8_t* channels)
+{
+  uint8_t count = 0;
+  VtxProfile& pr = currentProfile();
+  uint8_t pairCount = pr.pairCount;
+  for (uint8_t i = 0; i < pairCount; i++) {
+    if (vtxGetPairVisible(pr.pairs[i].value) != 0) continue;
+    if (pr.pairs[i].band != band) continue;
+    uint8_t c = pr.pairs[i].channel;
+    bool found = false;
+    for (uint8_t j = 0; j < count; j++) {
+      if (channels[j] == c) { found = true; break; }
+    }
+    if (!found) channels[count++] = c;
+  }
+  for (uint8_t i = 0; i < count; i++) {
+    for (uint8_t j = i + 1; j < count; j++) {
+      if (channels[j] < channels[i]) {
+        uint8_t t = channels[i];
+        channels[i] = channels[j];
+        channels[j] = t;
+      }
+    }
+  }
+  return count;
+}
+
+static bool channelValidForBand(uint8_t band, uint8_t channel)
+{
+  VtxProfile& pr = currentProfile();
+  uint8_t pairCount = pr.pairCount;
+  for (uint8_t i = 0; i < pairCount; i++) {
+    if (vtxGetPairVisible(pr.pairs[i].value) != 0) continue;
+    if (pr.pairs[i].band == band && pr.pairs[i].channel == channel)
+      return true;
+  }
+  return false;
+}
+
+static uint8_t findPairIndex(uint8_t band, uint8_t channel)
+{
+  VtxProfile& pr = currentProfile();
+  uint8_t pairCount = pr.pairCount;
+  for (uint8_t i = 0; i < pairCount; i++) {
+    if (pr.pairs[i].band == band && pr.pairs[i].channel == channel)
+      return i;
+  }
+  for (uint8_t i = 0; i < pairCount; i++) {
+    if (pr.pairs[i].band == band) return i;
+  }
+  return 0;
+}
+
+static void setPairByBandChannel(uint8_t band, uint8_t channel)
+{
+  vtxCurrentBand = band;
+  vtxCurrentChannel = channel;
+  vtxCurrentIndex = findPairIndex(band, channel);
+}
+
+static void advanceBand(int8_t delta)
+{
+  uint8_t bands[20];
+  uint8_t count = getUniqueBands(bands);
+  if (count == 0) return;
+
+  int8_t pos = -1;
+  for (uint8_t i = 0; i < count; i++) {
+    if (bands[i] == vtxCurrentBand) { pos = i; break; }
+  }
+  if (delta == 0) {
+    pos = 0;
+  } else {
+    if (pos < 0) pos = 0;
+    pos += delta;
+    while (pos < 0) pos += count;
+    while ((uint8_t)pos >= count) pos -= count;
+  }
+
+  uint8_t newBand = bands[pos];
+  uint8_t newChannel = vtxCurrentChannel;
+  if (!channelValidForBand(newBand, newChannel)) {
+    uint8_t channels[20];
+    uint8_t chanCount = getUniqueChannels(newBand, channels);
+    newChannel = (chanCount > 0) ? channels[0] : 1;
+  }
+  setPairByBandChannel(newBand, newChannel);
+}
+
+static void advanceChannel(int8_t delta)
+{
+  uint8_t channels[20];
+  uint8_t count = getUniqueChannels(vtxCurrentBand, channels);
+  if (count == 0) return;
+
+  int8_t pos = -1;
+  for (uint8_t i = 0; i < count; i++) {
+    if (channels[i] == vtxCurrentChannel) { pos = i; break; }
+  }
+  if (delta == 0) {
+    pos = 0;
+  } else {
+    if (pos < 0) pos = 0;
+    pos += delta;
+    while (pos < 0) pos += count;
+    while ((uint8_t)pos >= count) pos -= count;
+  }
+
+  setPairByBandChannel(vtxCurrentBand, channels[pos]);
+}
+
+static void advancePair(int8_t delta)
+{
+  VtxProfile& pr = currentProfile();
+  uint8_t visibleIdx[20];
+  uint8_t count = 0;
+  for (uint8_t i = 0; i < pr.pairCount; i++) {
+    if (vtxGetPairVisible(pr.pairs[i].value) == 0) visibleIdx[count++] = i;
+  }
+  if (count == 0) return;
+
+  int8_t pos = -1;
+  for (uint8_t i = 0; i < count; i++) {
+    if (visibleIdx[i] == vtxCurrentIndex) { pos = i; break; }
+  }
+  if (delta == 0) {
+    pos = 0;
+  } else {
+    if (pos < 0) pos = 0;
+    pos += delta;
+    while (pos < 0) pos += count;
+    while ((uint8_t)pos >= count) pos -= count;
+  }
+
+  uint8_t newIdx = visibleIdx[pos];
+  vtxCurrentIndex = newIdx;
+  vtxCurrentBand = pr.pairs[newIdx].band;
+  vtxCurrentChannel = pr.pairs[newIdx].channel;
+}
+
+void applyVtxAuto()
+{
+  if (!isVtxAutoEnabled()) return;
+
+  VtxProfile& pr = currentProfile();
+  uint8_t pairCount = pr.pairCount;
+  if (pairCount == 0) return;
+
+  uint8_t ch = pr.channel;
+  if (ch >= MAX_OUTPUT_CHANNELS) return;
+
+  uint8_t idx = vtxCurrentIndex;
+  if (idx >= pairCount) idx = pairCount - 1;
+
+  int16_t output = vtxGetPairValue(pr.pairs[idx].value);
+  if (output > 100) output = 100;
+  if (output < -100) output = -100;
+
+  int32_t pwm = ((int32_t)output * 1024) / 100;
+  if (pwm > 1024) pwm = 1024;
+  if (pwm < -1024) pwm = -1024;
+
+  channelOutputs[ch] = (int16_t)pwm;
+}
+
+static void doSwitchAction(uint8_t swIndex, int16_t elapsed, uint8_t advMode)
+{
+  int8_t delta = 0;
+  if (elapsed >= VTX_SHORT_MIN && elapsed <= VTX_SHORT_MAX) {
+    delta = -1;
+  } else if (elapsed >= VTX_MED_MIN && elapsed <= VTX_MED_MAX) {
+    delta = +1;
+  }
+  if (delta == 0) {
+    (void)swIndex;
+    return;
+  }
+  if (advMode == VTX_ADV_BAND) advanceBand(delta);
+  else if (advMode == VTX_ADV_CHANNEL) advanceChannel(delta);
+  else advancePair(delta);
+  (void)swIndex;
+}
+
+static void processSwitchSource(uint8_t swIndex, mixsrc_t src, uint8_t advMode)
+{
+  if (src <= MIXSRC_NONE || src > MIXSRC_LAST || isTrimSource(src)) return;
+
+  bool active = isSourceActive(src);
+  tmr10ms_t now = get_tmr10ms();
+
+  if (active) {
+    if (!vtxSwitchActive[swIndex]) {
+      vtxSwitchActive[swIndex] = true;
+      vtxSwitchTimer[swIndex] = now;
+      vtxSwitchReset[swIndex] = false;
+    } else if (!vtxSwitchReset[swIndex]) {
+      tmr10ms_t elapsed = (tmr10ms_t)(now - vtxSwitchTimer[swIndex]);
+      if (elapsed >= VTX_RESET_HOLD) {
+        if (advMode == VTX_ADV_BAND) advanceBand(0);
+        else if (advMode == VTX_ADV_CHANNEL) advanceChannel(0);
+        else advancePair(0);
+        vtxSwitchReset[swIndex] = true;
+      }
+    }
+  } else {
+    if (vtxSwitchActive[swIndex]) {
+      if (!vtxSwitchReset[swIndex]) {
+        tmr10ms_t elapsed = (tmr10ms_t)(now - vtxSwitchTimer[swIndex]);
+        doSwitchAction(swIndex, (int16_t)elapsed, advMode);
+      }
+      vtxSwitchActive[swIndex] = false;
+      vtxSwitchReset[swIndex] = false;
+    }
+  }
+}
+
+static void processTrimSource(uint8_t swIndex, mixsrc_t src, uint8_t advMode)
+{
+  if (!isTrimSource(src)) return;
+
+  bool left = false, right = false;
+  bool active = isTrimActive(src, left, right);
+  tmr10ms_t now = get_tmr10ms();
+
+  if (active) {
+    if (!vtxSwitchActive[swIndex]) {
+      vtxSwitchActive[swIndex] = true;
+      vtxSwitchTimer[swIndex] = now;
+      vtxSwitchReset[swIndex] = false;
+
+      if (left) {
+        if (advMode == VTX_ADV_BAND) advanceBand(-1);
+        else if (advMode == VTX_ADV_CHANNEL) advanceChannel(-1);
+        else advancePair(-1);
+      } else if (right) {
+        if (advMode == VTX_ADV_BAND) advanceBand(+1);
+        else if (advMode == VTX_ADV_CHANNEL) advanceChannel(+1);
+        else advancePair(+1);
+      }
+    } else if (!vtxSwitchReset[swIndex]) {
+      tmr10ms_t elapsed = (tmr10ms_t)(now - vtxSwitchTimer[swIndex]);
+      if (elapsed >= VTX_RESET_HOLD) {
+        if (advMode == VTX_ADV_BAND) advanceBand(0);
+        else if (advMode == VTX_ADV_CHANNEL) advanceChannel(0);
+        else advancePair(0);
+        vtxSwitchReset[swIndex] = true;
+      }
+    }
+  } else {
+    if (vtxSwitchActive[swIndex]) {
+      vtxSwitchActive[swIndex] = false;
+      vtxSwitchReset[swIndex] = false;
+    }
+  }
+}
+
+static void processManualSource(uint8_t swIndex, mixsrc_t src, uint8_t advMode)
+{
+  if (src <= MIXSRC_NONE || src > MIXSRC_LAST) return;
+  if (isTrimSource(src))
+    processTrimSource(swIndex, src, advMode);
+  else
+    processSwitchSource(swIndex, src, advMode);
+}
+
+static void processModeSource()
+{
+  VtxProfile& pr = currentProfile();
+  mixsrc_t src = pr.modeSrc;
+  if (src <= MIXSRC_NONE || src > MIXSRC_LAST) return;
+
+  bool active = false;
+  if (isTrimSource(src)) {
+    bool left, right;
+    active = isTrimActive(src, left, right);
+  } else {
+    active = isSourceActive(src);
+  }
+
+  if (active && !vtxSwitchActive[2]) {
+    pr.mode = pr.mode ? 0 : 1;
+  }
+  vtxSwitchActive[2] = active;
+}
+
+static bool pairExists(uint8_t band, uint8_t channel)
+{
+  VtxProfile& pr = currentProfile();
+  for (uint8_t i = 0; i < pr.pairCount; i++) {
+    if (pr.pairs[i].band == band && pr.pairs[i].channel == channel)
+      return true;
+  }
+  return false;
+}
+
+static void processFavorites()
+{
+  VtxProfile& pr = currentProfile();
+  tmr10ms_t now = get_tmr10ms();
+
+  for (uint8_t i = 0; i < MAX_VTX_FAVORITES; i++) {
+    mixsrc_t src = pr.favorites[i].src;
+    if (src <= MIXSRC_NONE || src > MIXSRC_LAST) continue;
+
+    bool active = false;
+    if (isTrimSource(src)) {
+      bool left = false, right = false;
+      active = isTrimActive(src, left, right);
+    } else {
+      active = isSourceActive(src);
+    }
+
+    if (active && !vtxFavoritePrev[i]) {
+      uint8_t band = pr.favorites[i].band;
+      uint8_t channel = pr.favorites[i].channel;
+      if (pairExists(band, channel)) {
+        setPairByBandChannel(band, channel);
+        vtxHoldTimer = now;
+      }
+    }
+    vtxFavoritePrev[i] = active;
+  }
+}
+
+static uint32_t wholeSecondTicks(uint16_t tenths)
+{
+  uint32_t sec = ((uint32_t)tenths + 5u) / 10u;
+  if (sec < 1u) sec = 1u;
+  return sec * 100u;
+}
+
+static uint32_t computeInterval(const VtxProfile& pr)
+{
+  uint32_t ticks;
+  // Stored in 0.1 s; intervals are whole seconds (100 ticks of 10 ms each).
+  if ((pr.timeType & 1) == 0) {
+    ticks = wholeSecondTicks(pr.fixedTime);
+  } else {
+    uint32_t minT = wholeSecondTicks(pr.minTime);
+    uint32_t maxT = wholeSecondTicks(pr.maxTime);
+    if (maxT < minT) maxT = minT;
+    uint32_t steps = (maxT - minT) / 100u;
+    ticks = minT + 100u * (vtxRand() % (steps + 1));
+  }
+  if (ticks < 100) ticks = 100;
+  if (ticks > 180000) ticks = 180000;
+  return ticks;
+}
+
+static uint8_t getWeightedRandomPair()
+{
+  VtxProfile& pr = currentProfile();
+  uint8_t visibleIdx[20];
+  uint16_t weights[20];
+  uint8_t count = 0;
+  uint16_t total = 0;
+
+  for (uint8_t i = 0; i < pr.pairCount; i++) {
+    if (vtxGetPairVisible(pr.pairs[i].value) != 0) continue;
+    uint8_t p = vtxGetPairPriority(pr.pairs[i].value);
+    uint16_t w = (p == 0) ? 10 : (p * p);
+    visibleIdx[count] = i;
+    weights[count] = w;
+    total += w;
+    count++;
+  }
+
+  if (count == 0 || total == 0) return vtxCurrentIndex;
+
+  uint16_t r = (uint16_t)(vtxRand() % total);
+  uint16_t sum = 0;
+  for (uint8_t i = 0; i < count; i++) {
+    sum += weights[i];
+    if (r < sum) return visibleIdx[i];
+  }
+  return visibleIdx[count - 1];
+}
+
+void checkVtxAuto()
+{
+  if (!isVtxAutoEnabled()) {
+    vtxIntervalTicks = 0;
+    vtxPrevMode = 0xFF;
+    vtxPrevProfile = 0xFF;
+    return;
+  }
+
+  VtxProfile& pr = currentProfile();
+  uint8_t pairCount = pr.pairCount;
+  if (pairCount == 0) return;
+
+  if (vtxCurrentIndex >= pairCount) {
+    vtxSetCurrentIndex(0);
+  }
+
+  if (pr.mode != vtxPrevMode || g_model.vtxAuto.activeProfile != vtxPrevProfile) {
+    vtxIntervalTicks = 0;
+    vtxPrevMode = pr.mode;
+    vtxPrevProfile = g_model.vtxAuto.activeProfile;
+    if (pr.mode == 1) vtxHoldTimer = get_tmr10ms();
+  }
+
+  processFavorites();
+
+  processModeSource();
+
+  if (pr.mode == 0) {
+    if ((pr.timeType >> 1) & 1) {
+      processManualSource(0, pr.bandSrc, VTX_ADV_PAIR);
+    } else {
+      processManualSource(0, pr.bandSrc, VTX_ADV_BAND);
+      processManualSource(1, pr.chanSrc, VTX_ADV_CHANNEL);
+    }
+  } else {
+    tmr10ms_t now = get_tmr10ms();
+
+    if (vtxIntervalTicks == 0) {
+      vtxHoldTimer = now;
+      vtxIntervalTicks = computeInterval(pr);
+    }
+
+    if ((tmr10ms_t)(now - vtxHoldTimer) >= (tmr10ms_t)vtxIntervalTicks) {
+      uint8_t newIndex = getWeightedRandomPair();
+      vtxSetCurrentIndex(newIndex);
+      // Advance by the nominal interval (not to `now`) so mixer-task latency does not
+      // accumulate: N switches take exactly N*interval of 10 ms ticks.
+      vtxHoldTimer += (tmr10ms_t)vtxIntervalTicks;
+      if ((tmr10ms_t)(now - vtxHoldTimer) >= (tmr10ms_t)vtxIntervalTicks) vtxHoldTimer = now;
+      vtxIntervalTicks = computeInterval(pr);
+    }
+  }
+}
+
+#endif
