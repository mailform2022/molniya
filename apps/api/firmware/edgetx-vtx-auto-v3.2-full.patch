+void menuModelVtxPairs(event_t event)
+{
+  VtxProfile* pr = currentVtxProfile();
+  if (!pr) return;
+
+  uint8_t sub = menuVerticalPosition - HEADER_LINE;
+  uint8_t pairCount = pr->pairCount;
+  uint8_t pairRows = pairCount + 2;
+
+  if (event == EVT_KEY_BREAK(KEY_ENTER)) {
+    if (sub < pairCount) {
+      s_currIdxSubMenu = sub;
+      pushMenu(menuModelVtxPair);
+      killEvents(event);
+      return;
+    } else if (sub == pairCount && pairCount < MAX_VTX_PAIRS) {
+      VtxPair& np = pr->pairs[pairCount];
+      np.band = 0;
+      np.channel = 1;
+      np.value = vtxEncodePairValue(-100, 0, 0);
+      for (uint8_t n = 0; n < 26 * 8; n++) {
+        bool dup = false;
+        for (uint8_t i = 0; i < pairCount; i++) {
+          if (pr->pairs[i].band == np.band && pr->pairs[i].channel == np.channel) {
+            dup = true;
+            break;
+          }
+        }
+        if (!dup) break;
+        np.channel++;
+        if (np.channel > 8) { np.channel = 1; np.band++; if (np.band > 25) np.band = 0; }
+      }
+      pr->pairCount++;
+      s_currIdxSubMenu = pairCount;
+      pushMenu(menuModelVtxPair);
+      killEvents(event);
+      return;
+    } else if (sub == pairCount + 1) {
+      pushMenu(menuModelVtxSort);
+      killEvents(event);
+      return;
+    }
+  }
+
+  if (event == EVT_KEY_LONG(KEY_ENTER) && sub < pairCount) {
+    for (uint8_t i = sub; i < pr->pairCount - 1; i++) {
+      pr->pairs[i] = pr->pairs[i + 1];
+    }
+    pr->pairCount--;
+    pairCount = pr->pairCount;
+    pairRows = pairCount + 2;
+    if (sub >= pairRows && pairRows > 0) {
+      menuVerticalPosition = HEADER_LINE + pairRows - 1;
+      menuVerticalOffset = 0;
+    }
+    killEvents(event);
+    event = 0;
+  }
+
+  SIMPLE_SUBMENU("PAIRS", HEADER_LINE + pairRows);
+
+  for (uint8_t i = 0; i < LCD_LINES - 1; i++) {
+    coord_t y = MENU_HEADER_HEIGHT + 1 + i * FH;
+    uint8_t k = i + menuVerticalOffset;
+    LcdFlags attr = (sub == k ? INVERS : 0);
+
+    if (k >= pairRows) continue;
+
+    if (k < pairCount) {
+      lcdDrawNumber(0, y, k + 1, attr | LEFT);
+      lcdDrawChar(3 * FW, y, vtxGetBandLetter(k), attr);
+      uint8_t code = vtxGetChannelCode(k);
+      uint8_t disp = vtxGetChannelDisplayChar(k);
+      if (disp) {
+        lcdDrawChar(5 * FW, y, disp, attr);
+      } else if (code >= 10) {
+        lcdDrawNumber(5 * FW, y, code, attr | LEFT);
+      } else {
+        lcdDrawChar(5 * FW, y, '0' + code, attr);
+      }
+      lcdDrawNumber(11 * FW, y, vtxGetPairValue(pr->pairs[k].value), attr | LEFT);
+    } else if (k == pairCount) {
+      lcdDrawText(2 * FW, y, "Add pair", attr);
+    } else {
+      lcdDrawText(2 * FW, y, "Sort", attr);
+    }
+  }
+}
