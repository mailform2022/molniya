+#include "vtx_auto.h"
+
+#if defined(RADIO_TX12) || defined(RADIO_TX12MK2) || defined(RADIO_POCKET) || defined(RADIO_BOXER)
+
+#include "edgetx.h"
+#include "globals.h"
