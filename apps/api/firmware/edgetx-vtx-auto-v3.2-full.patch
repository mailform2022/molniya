+static void updateVtxMStateTab(uint8_t* tab, VtxProfile* pr)
+{
+  for (uint8_t i = 0; i < ITEM_VTX_COUNT; i++) tab[i] = 0;
+
+  if (g_model.vtxAuto.profileCount >= MAX_VTX_PROFILES)
+    tab[ITEM_VTX_ADD_PROFILE] = HIDDEN_ROW;
+  if (g_model.vtxAuto.profileCount <= 1)
+    tab[ITEM_VTX_DELETE_PROFILE] = HIDDEN_ROW;
+
+  if (pr->mode == 0) { // Manual
+    tab[ITEM_VTX_TIME_TYPE] = HIDDEN_ROW;
+    tab[ITEM_VTX_FIXED_TIME] = HIDDEN_ROW;
+    tab[ITEM_VTX_MIN_TIME] = HIDDEN_ROW;
+    tab[ITEM_VTX_MAX_TIME] = HIDDEN_ROW;
+    if (isVtxPairStepMode(pr)) {
+      tab[ITEM_VTX_CHAN_SRC] = HIDDEN_ROW;
+    }
+  } else { // Auto
+    tab[ITEM_VTX_MANUAL_TYPE] = HIDDEN_ROW;
+    tab[ITEM_VTX_BAND_SRC] = HIDDEN_ROW;
+    tab[ITEM_VTX_CHAN_SRC] = HIDDEN_ROW;
+    if ((pr->timeType & 1) == 0) { // Fixed
+      tab[ITEM_VTX_MIN_TIME] = HIDDEN_ROW;
+      tab[ITEM_VTX_MAX_TIME] = HIDDEN_ROW;
+    } else { // Random
+      tab[ITEM_VTX_FIXED_TIME] = HIDDEN_ROW;
+    }
+  }
+}
