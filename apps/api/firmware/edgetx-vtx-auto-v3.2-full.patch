+      }
+    }
+    if (i >= ITEM_VTX_COUNT) break;
+
+    coord_t y = MENU_HEADER_HEIGHT + 1 + k * FH;
+    LcdFlags attr = (sub == i ? (s_editMode > 0 ? BLINK | INVERS : INVERS) : 0);
+    bool active = (attr && s_editMode > 0);
+
+    switch (i) {
+      case ITEM_VTX_ENABLED:
+        lcdDrawTextAlignedLeft(y, "Enabled");
+        g_model.vtxAuto.enabled = editChoice(VTX_2ND_COLUMN, y, nullptr,
+                                             vtxOnOffNames,
+                                             g_model.vtxAuto.enabled, 0, 1,
+                                             attr, event);
+        break;
